# Copy to .env on the server. Never commit the real .env file.
# Keep permissions restricted (for example: chmod 600 .env).

# Required when using PostgreSQL-backed accounts:
CSY_ACCOUNT_STORAGE=postgres
DATABASE_URL=postgres://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME

# Card Stuff Yes transactional email (Resend).
# Paste the CSY-specific Resend API key into the server's private .env file only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CSY_EMAIL_FROM="CardStuffYes <noreply@cardstuffyes.ca>"
CSY_EMAIL_REPLY_TO=contact@teamblacklight.ca
CSY_PUBLIC_BASE_URL=https://account.cardstuffyes.ca

# Optional: keep the deployed frontend's exact origins in sync with the API.
# CSY_ALLOWED_ORIGINS=https://cardstuffyes.ca,https://account.cardstuffyes.ca
