{
  "name": "card-stuff-yes-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Card Stuff Yes desktop client for Windows and Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ca.cardstuffyes.desktop",
    "productName": "Card Stuff Yes",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "url-policy.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "maintainer": "Team Blacklight"
    }
  },
  "homepage": "https://github.com/Innygr/Card-Stuff-Yes",
  "author": {
    "name": "Team Blacklight"
  },
  "desktopName": "Card Stuff Yes",
  "license": "MIT"
}
