{
  "name": "card-stuff-yes-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Card Stuff Yes desktop client for Windows and Linux",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --linux AppImage deb" },
  "devDependencies": { "electron": "^39.2.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "ca.cardstuffyes.desktop",
    "productName": "Card Stuff Yes",
    "asar": true,
    "files": ["main.js", "preload.js", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "linux": { "category": "Game", "target": ["AppImage", "deb"] }
  }
}
